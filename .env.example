# Nur für Alpaca nötig. Kopieren nach ~/.config/marktdaten/alpaca.env (chmod 600)
# oder als Umgebungsvariablen setzen. Schlüssel: app.alpaca.markets > Paper Trading > API Keys
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Nur für die Tageskerzen-Historie deutscher Werte (EODHD, Gratisplan genügt: eodhd.com/register).
# Kopieren nach ~/.config/marktdaten/eodhd.env (chmod 600)
EODHD_API_TOKEN=

# Nur für SEC EDGAR nötig: die SEC verlangt einen User-Agent mit Kontakt
# MARKTDATEN_KONTAKT=Vorname Nachname mail@beispiel.de
